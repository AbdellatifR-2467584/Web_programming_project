<!DOCTYPE html>
<html lang="nl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | ReciPin</title>
    <meta name="description" content="Login op ReciPin.">
    <link rel="icon" type="image/png" href="/resources/logo/Logo_cirkel.png">
    <link rel="stylesheet" href="/css/login.css">
</head>


<body>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const body = document.body;
            if (localStorage.getItem('darkmode') === 'enabled') {
                body.classList.add('dark-mode');
            }
        });
    </script>

    <section id="background" aria-hidden="true">
        <%- include('partials/grid') %>
    </section>

    <main id="login">
        <img class="logo" src="/resources/logo/Logo_cirkel.png" alt="Logo">
        <h1>Login</h1>

        <% if (error) { %>
            <p class="error">
                <%= error %>
            </p>
            <% } %>

                <form method="POST" action="/login" class="loginform">
                    <label>
                        <span>Email of Telefoonnummer</span>
                        <input type="text" name="contact" placeholder="Email of Telefoonnummer" required />
                    </label>
                    <label>
                        <span>Wachtwoord</span>
                        <input type="password" name="password" placeholder="Kies een wachtwoord" required />
                    </label>
                    <button type="submit">Login</button>
                </form>

                <a href="/register">Registreren</a>
    </main>
</body>

</html>